generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  TUTOR
  ADMIN
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO_LITE
  PRO_PLUS
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

enum SessionType {
  GROUP
  ONE_ON_ONE
}

enum CertificateType {
  MODULE
  TRACK
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SessionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TutorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  image         String?
  role          Role?
  emailVerified DateTime?
  googleId             String?  @unique
  googleRefreshToken   String?
  calendarConnected    Boolean   @default(false)
  googleAccessToken    String?
  calendarConnectedAt  DateTime?
  googleTokenExpiresAt Int?
  googleRefreshTokenExpiresIn Int?
  specialties          String[]  @default([])
  tutorBio             String?
  hasCompletedOnboarding Boolean @default(false)
  tutorStatus            TutorStatus?
  resumeLink             String?

  // Subscription
  subscriptionTier SubscriptionTier @default(FREE)
  oneOnOneSessionsRemaining Int @default(0)
  subscriptionId   String?          // Paystack subscription code
  credits1on1      Int              @default(0)
  subscriptionPeriodEnd DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  disabled      Boolean   @default(false)
  suspended     Boolean   @default(false)

  // Relations
  progress      Progress[]
  bookings      Booking[]
  tutorSessions TutorSession[] // Sessions taught by this user (if Tutor)
  enrollments   Enrollment[]
  sessionEnrollments SessionEnrollment[]
  accounts      Account[]
  sessions      Session[]
  badges        Badge[]
  certificates  Certificate[]
  
  studentRequests SessionRequest[] @relation("StudentRequests")
  tutorRequests   SessionRequest[] @relation("TutorRequests")
  transactions    PaymentTransaction[]
  activityLogs    ActivityLog[]
}

model PaymentTransaction {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  reference             String   @unique
  paystackTransactionId String?
  amount                Float
  currency              String   @default("NGN")
  status                String
  planCode              String?
  createdAt             DateTime @default(now())
}

model Track {
  id          String   @id @default(cuid())
  title       String
  description String
  published   Boolean  @default(false)
  
  modules      Module[]
  enrollments  Enrollment[]
  badges       Badge[]
  certificates Certificate[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  trackId     String
  track     Track    @relation(fields: [trackId], references: [id])
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@unique([userId, trackId])
}

model Module {
  id           String   @id @default(cuid())
  title        String
  order        Int
  
  trackId      String
  track        Track    @relation(fields: [trackId], references: [id])
  
  lessons      Lesson[]
  certificates Certificate[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  type        LessonType
  contentUrl  String?    // Video URL or PDF URL
  textContent String?    // Markdown content
  order       Int
  
  moduleId    String
  module      Module     @relation(fields: [moduleId], references: [id])
  
  progress    Progress[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
}

model Question {
  id        String   @id @default(cuid())
  text      String
  order     Int
  
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  options   Option[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model TutorSession {
  id          String      @id @default(cuid())
  title       String
  type        SessionType
  startTime   DateTime
  endTime     DateTime
  meetingLink String?
  googleEventId String?
  
  tutorId     String
  tutor       User        @relation(fields: [tutorId], references: [id])
  
  bookings    Booking[]
  sessionEnrollments  SessionEnrollment[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt @default(now())
  status      SessionStatus @default(PENDING)

  @@map("Session")
}

model SessionEnrollment {
  id           String @id @default(cuid())

  userId       String
  sessionId    String

  user         User         @relation(fields: [userId], references: [id])
  session      TutorSession @relation(fields: [sessionId], references: [id])

  enrolledAt   DateTime @default(now())

  @@unique([userId, sessionId]) // prevents double enrollment
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  tutorSessionId String @map("sessionId")
  tutorSession   TutorSession  @relation(fields: [tutorSessionId], references: [id], onDelete: Cascade)
  
  attended  Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@unique([userId, tutorSessionId])
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
}

model Certificate {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  type      CertificateType
  moduleId  String?
  module    Module?         @relation(fields: [moduleId], references: [id])
  trackId   String?
  track     Track?          @relation(fields: [trackId], references: [id])
  url       String
  createdAt DateTime        @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AuthSession")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model SessionRequest {
  id            String        @id @default(cuid())
  title         String
  studentId     String
  tutorId       String
  preferredTime String
  preferredDate String
  message       String?
  status        RequestStatus @default(PENDING)
  
  student       User          @relation("StudentRequests", fields: [studentId], references: [id])
  tutor         User          @relation("TutorRequests", fields: [tutorId], references: [id])
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g., "USER_REGISTERED", "PROFILE_UPDATED", "TRACK_CREATED"
  entityType String?  // e.g., "USER", "TRACK", "SESSION"
  entityId   String?
  metadata   Json?    // Additional context
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SiteBanner {
  id        String   @id @default(cuid())
  message   String
  href      String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, endsAt])
}
